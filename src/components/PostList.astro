---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/github";
import { readingTime } from "../lib/reading-time";

interface Props {
  posts: CollectionEntry<"writing">[];
}
const { posts } = Astro.props;
---

{
  posts.length > 0 ? (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}/`}>
            <time class="mono" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <span class="text">
              <span class="title">
                {post.data.title}
                {post.data.draft && <span class="todo">DRAFT</span>}
              </span>
              <span class="desc">{post.data.description}</span>
            </span>
            <span class="read mono">{readingTime(post.body)} min read</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">Nothing published yet.</p>
  )
}

<style>
  li {
    border-bottom: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    grid-template-areas: "date text read";
    gap: 0.25rem 3rem;
    padding-block: 1.25rem;
    text-decoration: none;
  }
  time {
    grid-area: date;
    padding-top: 0.2rem;
    color: var(--faint);
    font-size: var(--step--1);
  }
  .text {
    grid-area: text;
    display: grid;
    gap: 0.25rem;
  }
  .title {
    font-weight: 500;
  }
  .desc {
    max-width: 60ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .read {
    grid-area: read;
    padding-top: 0.2rem;
    color: var(--faint);
    font-size: var(--step--1);
    white-space: nowrap;
  }
  a:hover .title {
    color: var(--accent);
  }
  a:hover .desc {
    color: var(--muted);
  }
  .empty {
    padding-block: 2rem;
    color: var(--muted);
  }
  @media (max-width: 48rem) {
    a {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "date read"
        "text text";
      justify-content: start;
      gap: 0.375rem 1.5rem;
    }
  }
</style>
