---
import { getPosts } from "../lib/posts";

const path = Astro.url.pathname;
const hasPosts = (await getPosts()).length > 0;
// Writing stays out of the menu until there is something to read.
const nav = [
  { label: "Work", href: "/work" },
  ...(hasPosts ? [{ label: "Writing", href: "/writing" }] : []),
  { label: "About", href: "/about" },
];
---

<header class="header">
  <div class="wrap bar">
    <a class="home mono" href="/" aria-current={path === "/" ? "page" : undefined}>
      <span class="tilde">~/</span>zacharyk812
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a class="cta" href="/about#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }
  .home {
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .tilde {
    color: var(--accent);
  }
  ul {
    display: flex;
    align-items: center;
    gap: clamp(0.875rem, 2.5vw, 1.75rem);
  }
  nav a {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--text);
  }
  .cta {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  .cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  /* Tighten the bar on narrow phones so the menu fits on one line. */
  @media (max-width: 26rem) {
    .home {
      font-size: 0.8125rem;
    }
    ul {
      gap: 0.75rem;
    }
    .cta {
      padding-inline: 0.625rem;
    }
  }
</style>
