---
// One choice that shaped the project: what was picked, what was ruled
// out, and (in the slot) why.
interface Props {
  question: string;
  chose: string;
  rejected?: string[];
}
const { question, chose, rejected = [] } = Astro.props;
---

<section class="decision">
  <p class="question">{question}</p>
  <dl>
    <div>
      <dt>Chose</dt>
      <dd class="chose">{chose}</dd>
    </div>
    {
      rejected.length > 0 && (
        <div>
          <dt>Ruled out</dt>
          <dd>
            <ul>
              {rejected.map((r) => <li>{r}</li>)}
            </ul>
          </dd>
        </div>
      )
    }
  </dl>
  <div class="why"><slot /></div>
</section>

<style>
  .decision {
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    overflow: hidden;
  }
  .question {
    padding: 1rem 1.25rem;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-weight: 600;
    line-height: 1.4;
  }
  dl {
    margin: 0;
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  dl div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.375rem;
  }
  dt {
    color: var(--faint);
  }
  dd {
    margin: 0;
    color: var(--muted);
  }
  .chose {
    color: var(--text);
    font-weight: 500;
  }
  ul {
    display: grid;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }
  .why {
    padding: 1rem 1.25rem 1.125rem;
    color: var(--prose);
    font-size: 0.9375rem;
    line-height: 1.65;
  }
  .why :global(> * + *) {
    margin-top: 0.75em;
  }
  @media (max-width: 30rem) {
    dl div {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }
  }
</style>
