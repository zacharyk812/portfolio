---
// Wraps an image, an inline SVG or a diagram and gives it a caption.
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="figure">
  <div class="frame"><slot /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-inline: 0;
  }
  .frame {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
    color: var(--muted);
    overflow-x: auto;
  }
  .frame :global(img),
  .frame :global(svg) {
    width: 100%;
    height: auto;
    margin: 0;
    border: 0;
    border-radius: 0;
  }
  .frame :global(p) {
    margin: 0;
  }
  figcaption {
    margin-top: 0.625rem;
    color: var(--faint);
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
