---
import Icon from "./Icon.astro";
import { site, links, projects } from "../data/site";

// Shell transcript shown beside the intro. Each command types in once on
// load; everything is plain text and fully visible without JS.
const session = [
  { cmd: "whoami", out: [`${site.name.toLowerCase()} · ${site.role.toLowerCase()}`] },
  { cmd: "ls ~/projects", out: [projects.map((p) => `${p.name}/`).join("  ")] },
  { cmd: "echo $LOCATION", out: [site.location] },
];

let t = 0.35;
const lines = session.map((s) => {
  const cmdDelay = t;
  const typeTime = s.cmd.length * 0.045;
  const outDelay = cmdDelay + typeTime + 0.15;
  t = outDelay + 0.45;
  return { ...s, cmdDelay, typeTime, outDelay };
});
const caretDelay = t;
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="intro">
    <h1 id="hero-title">{site.name}</h1>
    <p class="role">{site.role}</p>
    <div class="bio">
      {site.bio.map((p) => <p>{p}</p>)}
    </div>
    <ul class="links">
      {
        links.map((l) => (
          <li>
            {l.placeholder ? (
              <span class="ghost">
                <Icon name={l.icon} />
                {l.label}
                <span class="todo">TODO</span>
              </span>
            ) : (
              <a href={l.href} class:list={{ primary: l.label === "GitHub" }}>
                <Icon name={l.icon} />
                {l.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <figure class="term" aria-label="Terminal session">
    <figcaption class="mono">zsh — ~</figcaption>
    <div class="screen mono">
      {
        lines.map((l) => (
          <Fragment>
            <p class="line">
              <span class="prompt" aria-hidden="true">$</span>
              <span class="cmd" style={`--n:${l.cmd.length};--d:${l.cmdDelay}s;--t:${l.typeTime}s`}>
                {l.cmd}
              </span>
            </p>
            {l.out.map((o) => (
              <p class="line out" style={`--d:${l.outDelay}s`}>
                {o}
              </p>
            ))}
          </Fragment>
        ))
      }
      <p class="line">
        <span class="prompt" aria-hidden="true">$</span>
        <span class="caret" style={`--d:${caretDelay}s`} aria-hidden="true"></span>
      </p>
    </div>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(4rem, 2rem + 9vw, 9rem) var(--space-section);
  }

  h1 {
    font-size: var(--step-display);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .role {
    margin-top: 1rem;
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--muted);
  }
  .bio {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
    margin-top: 1.75rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 2.5rem;
  }
  .links li {
    display: flex;
    align-items: center;
  }
  .links .ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--faint);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .links .ghost .todo {
    margin-left: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .links a.primary {
    padding: 0.625rem 1.125rem;
    background: var(--accent-fill);
    color: var(--accent-ink);
    border-radius: 999px;
    transition: background-color 0.2s var(--ease-out);
  }
  .links a.primary:hover {
    background: var(--accent-fill-hover);
    color: var(--accent-ink);
  }

  .term {
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--bg-raised);
    overflow: hidden;
  }
  figcaption {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.75rem;
    text-align: center;
  }
  .screen {
    margin: 0;
    padding: 1.25rem 1.25rem 1.5rem;
    font-size: 0.875rem;
    line-height: 1.8;
    overflow-x: auto;
  }
  .line {
    margin: 0;
    white-space: nowrap;
  }
  .prompt {
    margin-right: 1ch;
    color: var(--accent);
  }
  .out {
    color: var(--muted);
    white-space: pre;
  }
  .cmd {
    display: inline-block;
    vertical-align: bottom;
    overflow: hidden;
    white-space: nowrap;
  }
  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--text);
  }

  :global(html.motion) .cmd {
    width: 0;
    animation: type var(--t) steps(var(--n), end) var(--d) forwards;
  }
  :global(html.motion) .out {
    opacity: 0;
    animation: appear 0.3s var(--ease-out) var(--d) forwards;
  }
  :global(html.motion) .caret {
    animation: blink 1.1s steps(1, end) var(--d) infinite;
  }
  @keyframes type {
    to {
      width: calc(var(--n) * 1ch);
    }
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 56rem) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
