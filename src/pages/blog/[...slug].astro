---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { getPosts } from "../../lib/posts";
import { formatDate } from "../../lib/github";
import { readingTime } from "../../lib/reading-time";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="wrap post">
    <a class="back" href="/blog"><Icon name="arrow-left" size={14} />All posts</a>
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta mono">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="tags mono">
            {post.data.tags.map((t) => <li>#{t}</li>)}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    max-width: calc(var(--measure) + var(--gutter) * 2);
    padding-block: clamp(3rem, 2rem + 4vw, 5rem) var(--space-section);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  header {
    margin: 2.5rem 0 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  h1 {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    letter-spacing: -0.035em;
  }
  .meta {
    display: flex;
    gap: 0.625rem;
    margin-top: 1rem;
    color: var(--faint);
    font-size: var(--step--1);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .tags li {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .prose {
    color: #d3d8d5;
    line-height: 1.75;
  }
  .prose :global(> * + *) {
    margin-top: 1.25em;
  }
  .prose :global(h2) {
    margin-top: 2.5em;
    font-size: var(--step-2);
    color: var(--text);
  }
  .prose :global(h3) {
    margin-top: 2em;
    font-size: var(--step-1);
    color: var(--text);
  }
  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.75em;
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25em;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(li + li) {
    margin-top: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--faint);
  }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--bg-raised);
    font-size: 0.875em;
  }
  .prose :global(pre) {
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 0.875rem;
    line-height: 1.65;
    overflow-x: auto;
  }
  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: 1.25em;
    border-left: 1px solid var(--line-strong);
    color: var(--muted);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin-block: 3em;
  }
</style>
