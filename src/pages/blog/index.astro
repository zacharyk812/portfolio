---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---

<Base title="Blog" description="Notes on plugins, tooling and building for the web.">
  <div class="wrap page">
    <h1>Blog</h1>
    <p class="lede">Notes on plugins, tooling and building for the web.</p>
    <PostList posts={posts} />
  </div>
</Base>

<style>
  .page {
    padding-block: clamp(4rem, 3rem + 5vw, 7rem) var(--space-section);
  }
  h1 {
    font-size: clamp(2.75rem, 1.75rem + 4vw, 4.5rem);
    letter-spacing: -0.04em;
  }
  .lede {
    margin: 1rem 0 3rem;
    color: var(--muted);
    font-size: var(--step-1);
  }
</style>
