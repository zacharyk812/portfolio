---
import Base from "../../layouts/Base.astro";
import WorkGroups from "../../components/WorkGroups.astro";
import { getWork } from "../../lib/posts";

const work = await getWork();
const lede =
  "What I've built and what I'm building now. Each page explains how the thing works, including the projects that have no repo to point at.";
---

<Base title="Work" description={lede}>
  <div class="wrap page">
    <h1>Work</h1>
    <p class="lede">{lede}</p>
    <WorkGroups entries={work} level={2} />
  </div>
</Base>

<style>
  .page {
    padding-block: clamp(4rem, 3rem + 5vw, 7rem) var(--space-section);
  }
  h1 {
    font-size: clamp(2.75rem, 1.75rem + 4vw, 4.5rem);
    letter-spacing: -0.04em;
  }
  .lede {
    max-width: 40rem;
    margin: 1.25rem 0 4.5rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
